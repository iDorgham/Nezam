  },
  "design": {
    "designSpec": "DESIGN.md"
  },
  "architecture": {
    "allowed": [
      "docs/03_architecture/ARCHITECTURE.md",
      "docs/start/architecture/ARCHITECTURE.md",
      "docs/plans/04-arch/ARCHITECTURE.md"
