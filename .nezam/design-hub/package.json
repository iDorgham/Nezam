{
  "name": "@nezam/design-hub",
  "version": "1.0.0",
  "private": true,
  "description": "NEZAM Design Hub — Human-in-the-Loop design decision engine and profiles repository. Bridges planning and development.",
  "scripts": {
    "dev": "next dev --port ${PORT:-${NEZAM_DESIGN_PORT:-4000}}",
    "build": "next build",
    "start": "next start --port ${PORT:-${NEZAM_DESIGN_PORT:-4000}}",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "regenerate:sessions": "REGENERATE_SESSIONS=1 vitest run src/test/regenerate-page-sessions.integration.test.ts",
    "test:a11y": "vitest run src/test/color-a11y.wcag.test.ts src/test/ui-button.a11y.test.tsx src/test/ui-primitives.a11y.test.tsx",
    "a11y:report": "vitest run src/test/color-a11y.wcag.test.ts src/test/ui-button.a11y.test.tsx src/test/ui-primitives.a11y.test.tsx --reporter=verbose",
    "design:tokens:emit": "node scripts/emit-tokens.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@vercel/blob": "^2.4.0",
    "ai": "^6.0.195",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "immer": "^11.1.8",
    "lucide-react": "^1.17.0",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "simple-icons": "^16.21.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.28",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.3",
    "happy-dom": "^15",
    "playwright": "1.51.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vitest": "^4",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "browserslist": [
    ">0.3%",
    "not ie 11",
    "not dead",
    "not op_mini all"
  ]
}
