{
  "name": "nezam-workspace-kit",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "NEZAM — /command do everything. Cursor orchestration kit with optional semantic-release for workflow_dispatch automation.",
  "scripts": {
    "ai:sync": "node .nezam/core/scripts/sync/sync-ai-folders.js --write",
    "ai:status": "node .nezam/core/scripts/sync/sync-ai-folders.js --status",
    "ai:check": "node .nezam/core/scripts/checks/check-ai-drift.js && node .nezam/core/scripts/checks/check-sdd-swarm-integrity.js && node .nezam/core/scripts/checks/check-skill-frontmatter.js && node .nezam/core/scripts/checks/check-design-skills.js",
    "ai:check:sdd": "node .nezam/core/scripts/checks/check-sdd-swarm-integrity.js",
    "check:design-excellence": "bash scripts/checks/check-design-excellence.sh",
    "check:design-excellence:strict": "bash scripts/checks/check-design-excellence-strict.sh",
    "design:audit": "bash scripts/checks/check-design-excellence.sh",
    "design:audit:strict": "bash scripts/checks/check-design-excellence-strict.sh",
    "check:dashboard": "bash scripts/checks/check-dashboard-specs.sh",
    "scaffold:v3": "node scripts/scaffold-nezam-v3.js",
    "design:tokens:emit": "node .nezam/design-hub/scripts/emit-tokens.js",
    "check:tokens": "bash .nezam/core/scripts/checks/check-design-tokens.sh",
    "check:gate-5-a11y": "bash .nezam/core/scripts/checks/check-gate-5-a11y.sh",
    "check:gate-5-a11y:report": "bash .nezam/core/scripts/reports/write-gate-5-a11y-report.sh",
    "check:specs": "bash .nezam/core/scripts/checks/check-spec-versions.sh",
    "check:state": "node .nezam/core/scripts/checks/check-state-integrity.js",
    "check:all": "npm run check:tokens && npm run check:specs && npm run ai:check && npm run check:agent-bus && npm run check:state && npm run skills:registry",
    "check:onboarding": "bash .nezam/core/scripts/checks/check-onboarding-readiness.sh",
    "check:agent-bus": "node .nezam/core/scripts/checks/check-agent-bus.js",
    "skills:registry": "node .nezam/core/scripts/skills/generate-skills-registry.js",
    "skills:normalize": "node .nezam/core/scripts/skills/normalize-skill-ids.js",
    "skills:vendor-design": "node .nezam/core/scripts/skills/vendor-external-design-skills.js",
    "skills:assemble-design-prompt": "node .nezam/core/scripts/skills/assemble-design-prompt.js",
    "skills:doctor-design": "node .nezam/core/scripts/skills/design-skills-doctor.js doctor",
    "skills:list-design": "node .nezam/core/scripts/skills/design-skills-doctor.js list",
    "design:export-stitch": "bash .nezam/core/scripts/design/export-stitch-design-md.sh",
    "check:impeccable-slop": "bash .nezam/core/scripts/checks/check-impeccable-slop.sh",
    "report:swarm-cost": "node .nezam/core/scripts/reports/swarm-cost-report.js",
    "prd:roadmap": "node .nezam/core/scripts/prd/render-release-roadmap.mjs --write",
    "prd:roadmap:check": "node .nezam/core/scripts/prd/render-release-roadmap.mjs --check",
    "design:apply": "bash .nezam/core/scripts/design/copy-profile-to-design-md.sh",
    "changelog:draft": "node .nezam/core/scripts/changelog/draft-from-tasks.js",
    "changelog:finalize": "node .nezam/core/scripts/changelog/finalize-from-commit.js",
    "continual-learning": "node .nezam/core/scripts/continual-learning/run-silent.js",
    "continual-learning:prepare": "node .nezam/core/scripts/continual-learning/prepare-incremental.js --json --silent",
    "continual-learning:benchmark": "node .nezam/core/scripts/continual-learning/benchmark.js",
    "continual-learning:on": "node .nezam/core/scripts/continual-learning/enable.js",
    "continual-learning:off": "node .nezam/core/scripts/continual-learning/disable.js",
    "continual-learning:reset-memory": "node .nezam/core/scripts/continual-learning/reset-memory.js",
    "hooks:install": "bash .nezam/core/scripts/context/install-context-hooks.sh && bash .nezam/core/scripts/context/auto-memory-hooks.sh --install",
    "docs:wiki": "pnpm dlx docsify-cli@4.4.4 serve docs/wiki --port 3040 --no-open",
    "state:set": "node .nezam/core/scripts/state/write-state.js",
    "design-hub": "cd .nezam/design-hub && pnpm dev",
    "wireframe:server": "pnpm design-hub",
    "design-hub:build": "cd .nezam/design-hub && pnpm build",
    "design-hub:install": "cd .nezam/design-hub && pnpm install",
    "perf:lhci": "pnpm dlx @lhci/cli@0.14.0 autorun --config=.lighthouserc.json",
    "security:audit": "npm audit --registry=https://registry.npmjs.org --audit-level=high",
    "docs-site": "cd .nezam/docs-site && pnpm dev",
    "docs-site:build": "cd .nezam/docs-site && pnpm build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "next": "latest",
    "qrcode.react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@types/react": "19.2.16",
    "impeccable": "^2.1.9",
    "js-yaml": "^4.1.0",
    "semantic-release": "^25.0.3",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.4.3"
    }
  }
}
